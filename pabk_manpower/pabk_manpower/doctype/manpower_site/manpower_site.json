{
    "doctype": "DocType",
    "name": "Manpower Site",
    "module": "PABK Manpower",
    "custom": 0,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 0,
    "track_changes": 1,
    "title_field": "site_name",
    "search_fields": "site_name,client,site_code",
    "field_order": [
        "section_break_1",
        "site_code",
        "site_name",
        "status",
        "contracted_headcount",
        "deployed_headcount",
        "client",
        "section_break_2",
        "address",
        "city",
        "contact_person",
        "contact_phone",
        "contact_email",
        "section_break_3",
        "shift_type",
        "working_days",
        "notes"
    ],
    "fields": [
        {
            "fieldname": "section_break_1",
            "fieldtype": "Section Break",
            "label": "Site Details"
        },
        {
            "fieldname": "site_code",
            "fieldtype": "Data",
            "label": "Site Code",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "site_name",
            "fieldtype": "Data",
            "label": "Site Name",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Active\nInactive",
            "default": "Active",
            "in_list_view": 1,
            "reqd": 1
        },
        {
            "fieldname": "contracted_headcount",
            "fieldtype": "Int",
            "label": "Total Contracted Headcount",
            "read_only": 1,
            "default": 0,
            "description": "Sum of headcount from all active contracts at this site"
        },
        {
            "fieldname": "deployed_headcount",
            "fieldtype": "Int",
            "label": "Total Deployed Headcount",
            "read_only": 1,
            "default": 0,
            "description": "Sum of deployed from all active contracts at this site"
        },
        {
            "fieldname": "client",
            "fieldtype": "Link",
            "label": "Client",
            "options": "Customer",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "section_break_2",
            "fieldtype": "Section Break",
            "label": "Location & Contact"
        },
        {
            "fieldname": "address",
            "fieldtype": "Text",
            "label": "Address"
        },
        {
            "fieldname": "city",
            "fieldtype": "Data",
            "label": "City"
        },
        {
            "fieldname": "contact_person",
            "fieldtype": "Data",
            "label": "Contact Person"
        },
        {
            "fieldname": "contact_phone",
            "fieldtype": "Data",
            "label": "Contact Phone"
        },
        {
            "fieldname": "contact_email",
            "fieldtype": "Data",
            "label": "Contact Email"
        },
        {
            "fieldname": "section_break_3",
            "fieldtype": "Section Break",
            "label": "Operations"
        },
        {
            "fieldname": "shift_type",
            "fieldtype": "Link",
            "label": "Default Shift Type",
            "options": "Shift Type"
        },
        {
            "fieldname": "working_days",
            "fieldtype": "Select",
            "label": "Working Days",
            "options": "Mon-Fri\nMon-Sat\nMon-Sun\nShift Rotation",
            "default": "Mon-Sat"
        },
        {
            "fieldname": "notes",
            "fieldtype": "Text",
            "label": "Notes"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Sales Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "HR Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1
        }
    ],
    "naming_series": "MST-.YYYY.-",
    "autoname": "naming_series:",
    "sort_field": "modified",
    "sort_order": "DESC"
}
