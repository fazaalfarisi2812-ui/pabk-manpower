{
    "doctype": "DocType",
    "name": "Manpower Contract",
    "module": "PABK Manpower",
    "custom": 0,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 0,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_copy": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_web_view": 0,
    "title_field": "contract_name",
    "search_fields": "client,site,contract_number",
    "field_order": [
        "section_break_1",
        "contract_number",
        "contract_name",
        "headcount",
        "deployed_count",
        "client",
        "site",
        "section_break_2",
        "start_date",
        "end_date",
        "billing_cycle",
        "markup_pct",
        "section_break_3",
        "replacement_sla_days",
        "shift_template",
        "section_break_4",
        "terms_and_conditions",
        "status"
    ],
    "fields": [
        {
            "fieldname": "section_break_1",
            "fieldtype": "Section Break",
            "label": "Contract Details"
        },
        {
            "fieldname": "contract_number",
            "fieldtype": "Data",
            "label": "Contract Number",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "contract_name",
            "fieldtype": "Data",
            "label": "Contract Name",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "headcount",
            "fieldtype": "Int",
            "label": "Contracted Headcount",
            "reqd": 1,
            "default": 1,
            "description": "Total number of positions contracted"
        },
        {
            "fieldname": "deployed_count",
            "fieldtype": "Int",
            "label": "Currently Deployed",
            "read_only": 1,
            "default": 0,
            "description": "Auto-calculated from active shift assignments"
        },
        {
            "fieldname": "client",
            "fieldtype": "Link",
            "label": "Client",
            "options": "Customer",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "site",
            "fieldtype": "Link",
            "label": "Site",
            "options": "Manpower Site",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "section_break_2",
            "fieldtype": "Section Break",
            "label": "Billing & Commercial"
        },
        {
            "fieldname": "start_date",
            "fieldtype": "Date",
            "label": "Start Date",
            "reqd": 1
        },
        {
            "fieldname": "end_date",
            "fieldtype": "Date",
            "label": "End Date",
            "reqd": 1
        },
        {
            "fieldname": "billing_cycle",
            "fieldtype": "Select",
            "label": "Billing Cycle",
            "options": "Weekly\nBi-Weekly\nMonthly",
            "default": "Monthly",
            "reqd": 1
        },
        {
            "fieldname": "markup_pct",
            "fieldtype": "Percent",
            "label": "Markup %",
            "precision": 2,
            "default": 0,
            "description": "Markup percentage on top of cost"
        },
        {
            "fieldname": "section_break_3",
            "fieldtype": "Section Break",
            "label": "Operations"
        },
        {
            "fieldname": "replacement_sla_days",
            "fieldtype": "Int",
            "label": "Replacement SLA (Days)",
            "default": 3,
            "description": "Days to provide replacement staff"
        },
        {
            "fieldname": "shift_template",
            "fieldtype": "Link",
            "label": "Shift Template",
            "options": "Shift Type",
            "description": "Default shift for this contract"
        },
        {
            "fieldname": "section_break_4",
            "fieldtype": "Section Break",
            "label": "Terms & Status"
        },
        {
            "fieldname": "terms_and_conditions",
            "fieldtype": "Text Editor",
            "label": "Terms & Conditions"
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Draft\nActive\nExpired\nTerminated",
            "default": "Draft",
            "in_list_view": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Sales Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "HR Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1
        }
    ],
    "naming_series": "MCT-.YYYY.-",
    "autoname": "naming_series:",
    "sort_field": "modified",
    "sort_order": "DESC"
}
